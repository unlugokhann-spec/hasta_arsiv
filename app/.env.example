# Firebase projenizin ayarlarından (Project Settings > General > Your apps) kopyalayın
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsiyonel: Firestore veritabanınız konsolda özel "(default)" kimliği yerine
# başka bir adla (örn. "default") oluşturulduysa burada belirtin.
VITE_FIRESTORE_DATABASE_ID=
