rules_version = '2';

// Med Archive - Firestore güvenlik kuralları
// Roller: 'staff' (klinik çalışanı) ve 'patient' (hasta)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && userData().role == 'staff';
    }

    function sameClinic(clinicId) {
      return isSignedIn() && userData().clinicId == clinicId;
    }

    // Klinikler: herkes davet kodunu doğrulamak için okuyabilir, sadece kayıt sırasında oluşturulabilir
    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Kullanıcı profilleri
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || sameClinic(resource.data.clinicId));
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Randevular: hasta kendi randevusunu oluşturur/görür, klinik çalışanı kendi kliniğinin tüm randevularını görür/günceller
    match /appointments/{id} {
      allow read: if isSignedIn() && (resource.data.patientId == request.auth.uid || sameClinic(resource.data.clinicId) && isStaff());
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && sameClinic(request.resource.data.clinicId);
      allow update: if isSignedIn() && isStaff() && sameClinic(resource.data.clinicId);
      allow delete: if false;
    }

    // Hasta <-> klinik mesajlaşması
    match /conversations/{id} {
      allow read, update: if isSignedIn()
        && (resource.data.patientId == request.auth.uid || (isStaff() && sameClinic(resource.data.clinicId)));
      allow create: if isSignedIn()
        && (request.resource.data.patientId == request.auth.uid || isStaff())
        && sameClinic(request.resource.data.clinicId);
      allow delete: if false;

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }
  }
}
